{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Shared compiler settings. Every package extends this. Sources import each other with explicit .ts/.tsx extensions so Node can run them directly (type stripping) and Vite/esbuild can bundle them; tsc only type-checks (noEmit).",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
