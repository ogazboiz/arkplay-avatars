{
  "name": "@arkplay/avatar-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React creator UI for ArkPlay avatars: schema-driven editor, randomizer, wardrobe, animation preview and the export dialog. Used by the ArkPlay website and the standalone studio app.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/studio.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@arkplay/avatar-client": "*",
    "@arkplay/avatar-engine": "*",
    "@arkplay/avatar-vision": "*",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9"
  }
}
